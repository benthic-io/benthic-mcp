BENTHIC_MCP_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BENTHIC_MCP_HOST=0.0.0.0
BENTHIC_MCP_PORT=8082
BENTHIC_MCP_PATH=/mcp
BENTHIC_MCP_ALLOWED_HOSTS=192.168.10.222:8082,127.0.0.1:8082,localhost:8082,[::1]:8082
BENTHIC_MCP_ALLOWED_ORIGINS=http://192.168.10.222:8081
BENTHIC_AGGREGATE_SCAN_LIMIT=10000

# Playbook: dataset-specific access instructions served to the calling LLM.
#   off    - no playbook; benthic_playbook reports "disabled"
#   seed   - the curated seed in src/benthic_mcp/seed.py (default)
#   active - the promoted playbook, falling back to the seed if the file is missing
# A new playbook takes effect on service restart.
BENTHIC_PLAYBOOK_MODE=seed
BENTHIC_PLAYBOOK_PATH=/home/otherdrums/.cache/benthic-mcp/playbook.json
# Token budget for the always-on core slice injected into the benthic_discover description.
BENTHIC_PLAYBOOK_TOKEN_BUDGET=600

# Self-improvement: lessons reported by calling LLMs through benthic_report.
# Always pending until eval/consolidate.py and eval/promote.py promote them.
BENTHIC_TRACE_ENABLED=1
BENTHIC_TRACE_RETENTION_DAYS=30
BENTHIC_LESSON_RETENTION_DAYS=30
# Set to 1 to store the question text from benthic_report. Off by default: only a
# hash of the question is kept.
BENTHIC_TRACE_INCLUDE_TEXT=0

# Consolidator LLM. Defaults to the local llama-server; override to use a stronger model.
# BENTHIC_CONSOLIDATOR_LLM_URL=http://192.168.10.222:8081
# BENTHIC_CONSOLIDATOR_MODEL=

# Harness only. The improvement loop runs under its own cache dir so a run never
# touches this store; set BENTHIC_CACHE_DIR to override when invoking eval/harness.py
# or eval/guard.py.
# BENTHIC_CACHE_DIR=/home/otherdrums/mcp-tools/eval/harness/cache

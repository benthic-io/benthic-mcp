[Unit]
Description=Read-only Benthic MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/otherdrums/mcp-tools
EnvironmentFile=%h/.config/benthic-mcp/env
ExecStart=/home/otherdrums/mcp-tools/.venv/bin/benthic-mcp
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target

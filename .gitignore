.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.env
logs/

# Experiment sandboxes and archived run evidence. Every one of these is regenerated by a command
# in the docs, and together they are tens of MB of model transcripts and scored results, some of
# which embed rows returned by the datasets.
#
# These are globs rather than one name each, because listing them individually meant a newly named
# sandbox was committed by default and 82MB of transcripts ended up in the history of a repo that had
# already ignored its siblings.
eval/harness*/
eval/runs/
eval/noise*/
eval/arms*/
eval/attrib*/
eval/validate*/
eval/attrib-suite*/
BENTHIC_AUDIT_DIR=/tmp/opencode/audit

eval/observer/records/
eval/observer/findings.json
eval/observer/.agent-session
eval/observer/.tick.lock
grok/
